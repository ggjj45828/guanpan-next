# 复制本文件为 .env 并填入真实值（docker compose 会自动读取同目录下的 .env）
# 仅 NAS 侧后台研究 / 模拟使用；key 不会下发到 iOS 或网页端。

# 【必填】DeepSeek API Key；不填则后台研究只保留本地因子、不生成 AI 文字。
DEEPSEEK_API_KEY=

# AI 档案：flash（默认，deepseek-flash）/ pro（deepseek-v4-pro）/ custom
GUANPAN_AI_PROFILE=flash

# 仅当 GUANPAN_AI_PROFILE=custom 时填写
GUANPAN_AI_BASE_URL=
GUANPAN_AI_MODEL=
