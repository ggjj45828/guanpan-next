# No application passphrase is required. Keep 8786 inside your trusted LAN or VPN.
# Optional: GUANPAN_NEXT_DATA=/data

# DeepSeek only runs after you set your own API key on NAS. Never commit .env.
# Preset profiles: flash (deepseek-flash), pro (deepseek-v4-pro), custom.
DEEPSEEK_API_KEY=
GUANPAN_AI_PROFILE=flash
# Only for GUANPAN_AI_PROFILE=custom; HTTPS OpenAI-compatible endpoint:
GUANPAN_AI_BASE_URL=
GUANPAN_AI_MODEL=
